# OpenSOC Forge Default NIDS Detection Rules

# Synthetic test alert rule for healthchecks and pipeline verification
alert ip any any -> any any (msg:"OPENSOC FORGE Synthetic Healthcheck Alert"; content:"OPENSOC_SYNTHETIC_PING"; nocase; sid:9000001; rev:1; metadata:confidence high, source opensoc-ctl;)

# ICMP Ping Detection
alert icmp any any -> $HOME_NET any (msg:"OPENSOC NIDS ICMP Echo Request Detected"; itype:8; sid:9000002; rev:1; classtype:misc-activity;)

# Suspicious port scan activity
alert tcp any any -> $HOME_NET 22 (msg:"OPENSOC NIDS SSH Inbound Connection Attempt"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:9000003; rev:1; classtype:attempted-recon;)

# Suspicious HTTP Command Injection / Directory Traversal Attempt
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"OPENSOC NIDS HTTP Directory Traversal Detected"; http.uri; content:"/../"; sid:9000004; rev:1; classtype:web-application-attack;)

# Suspicious TLS SNI Inspection
alert tls any any -> any any (msg:"OPENSOC NIDS Potential Cobalt Strike TLS Beaconing"; tls.sni; content:"pastebin.com"; nocase; sid:9000005; rev:1; classtype:trojan-activity;)
