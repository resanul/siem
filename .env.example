# ==============================================================================
# OpenSOC Forge - Environment Configuration Template
# Copy this file to .env before running docker compose or installer
# ==============================================================================

# Core Authentication & Secrets
ELASTIC_PASSWORD=OpenSocForge2026!
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=OpenSocForge2026!

# Network Interface Configuration
# The network interface monitored by Suricata AF_PACKET packet sniffer
# Run: ip link show | grep "state UP" to find your interface name
MONITORED_INTERFACE=eth0

# Service Port Allocations
MGMT_PORT=7070
ES_PORT=9200
ES_TRANSPORT_PORT=9300
KIBANA_PORT=5601
WAZUH_AGENT_TCP_PORT=1514
WAZUH_AGENT_UDP_PORT=1514
WAZUH_ENROLL_PORT=1515
WAZUH_API_PORT=55000
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
SYSLOG_TLS_PORT=6514

# Data Plane Component Connectivity (internal Docker network - HTTP, no TLS)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_SSL_VERIFY=false
WAZUH_API_URL=https://wazuh-manager:55000
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Host Directory Paths
OPENSOC_CERTS_DIR=/etc/opensoc/certs
OPENSOC_DATA_DIR=/var/lib/opensoc
OPENSOC_LOG_DIR=/var/log/opensoc
SURICATA_LOG_DIR=/var/log/suricata
